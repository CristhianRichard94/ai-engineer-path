# Copy to .env for local development (used by docker-compose.yml).
# On Fly.io, set these via `fly secrets set KEY=value` instead of committing
# a .env file.

APP_ENV=development

# OpenAI
OPENAI_API_KEY=

# Qdrant — for local dev this points at the docker-compose `qdrant` service.
# In production, point at a managed instance (e.g. Qdrant Cloud) instead of
# self-hosting on Fly.io.
QDRANT_URI=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=github_repos
QDRANT_VECTOR_SIZE=1536

# Redis / Celery — for local dev this points at the docker-compose `redis`
# service. In production, point at a managed instance (e.g. Upstash Redis)
# instead of self-hosting on Fly.io.
REDIS_URL=redis://localhost:6379/0

# GitHub
GITHUB_API_URL=https://api.github.com
